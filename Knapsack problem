#include <stdio.h>
// Function to find the maximum of two integers
int max(int a, int b) {
    return (a > b) ? a : b;
}

int main() {
    int N, W;

    // Read the number of items
    if (scanf("%d", &N) != 1) return 0;

    int values[N];
    int weights[N];

    // Read the values of the items
    for (int i = 0; i < N; i++) {
        if (scanf("%d", &values[i]) != 1) return 0;
    }

    // Read the weights of the items
    for (int i = 0; i < N; i++) {
        if (scanf("%d", &weights[i]) != 1) return 0;
    }

    // Read the capacity of the knapsack
    if (scanf("%d", &W) != 1) return 0;

    // dp array to store the maximum value for each weight capacity up to W
    // Using a 1D array optimized space from O(N*W) to O(W)
    int dp[W + 1];
    
    // Initialize the DP table with 0
    for (int j = 0; j <= W; j++) {
        dp[j] = 0;
    }

    // Process each item
    for (int i = 0; i < N; i++) {
        // Traverse backwards to prevent using the same item multiple times
        for (int j = W; j >= weights[i]; j--) {
            dp[j] = max(dp[j], dp[j - weights[i]] + values[i]);
        }
    }

    // The maximum value will be stored at dp[W]
    printf("%d\n", dp[W]);

    return 0;
}
